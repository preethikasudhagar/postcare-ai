# PostCare AI Frontend Environment Configuration

# Backend API URL (Production on Vercel)
# Set to your Render backend web service URL (without trailing slash)
# Example: https://postcare-ai-backend.onrender.com
# Leave blank or omit in local development to use Vite's built-in /api proxy
VITE_API_BASE_URL=https://your-render-backend-name.onrender.com

# Google Cloud OAuth 2.0 Client ID (Optional)
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Navigate to APIs & Services > Credentials
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Add Authorized JavaScript Origins (e.g. https://your-app.vercel.app and http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=
