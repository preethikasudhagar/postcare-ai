# ─────────────────────────────────────────────────────────────────────────────
# PostCare AI — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────────────────

# Django Core
SECRET_KEY=your-secure-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Production Database (Render PostgreSQL provides DATABASE_URL automatically)
DATABASE_URL=postgres://postcare_user:password@dpg-xxxxxx-a.oregon-postgres.render.com/postcare_ai

# Local Development Database Fallback (used when DATABASE_URL is not set)
# If DB_NAME is unset, Django automatically uses local SQLite (db.sqlite3)
# DB_NAME=postcare_ai
# DB_USER=postcare_user
# DB_PASSWORD=postcare_pass
# DB_HOST=localhost
# DB_PORT=5432

# CORS & CSRF (Set to your deployed Vercel frontend URL, comma-separated)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-backend.onrender.com

# Python Environment
PYTHON_VERSION=3.12.0
